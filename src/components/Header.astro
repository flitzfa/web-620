---
import { site } from '../content/site';
---

<header class="site-header">
  <a class="wordmark" href="#inicio" aria-label={`${site.band.name}, inicio`}>
    <span class="wordmark__number">{site.band.shortName}</span><span class="wordmark__name">Trío</span>
  </a>
  <nav aria-label="Navegación principal">
    {site.navigation.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>
</header>
