---
import { site } from '../content/site';
import SectionHeading from './SectionHeading.astro';
---

<section class="section music" id="musica" aria-labelledby="music-title">
  <div class="shell">
    <SectionHeading id="music-title" {...site.sections.music} />
    <div class="release-grid">
      {site.releases.map((release) => (
        <article class="release-card">
          <div class="release-card__video">
            <iframe
              src={release.youtubeUrl}
              title={`${site.band.name} — ${release.title}`}
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
            ></iframe>
          </div>
          <div class="release-card__body">
            <div class="release-card__meta">
              <p class="release-card__format">{release.format}</p>
              {release.status && <p class="release-card__status">{release.status}</p>}
            </div>
            <h3>{release.title}</h3>
            <p>{release.detail}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
