---
import { site } from '../content/site';
import { Image } from 'astro:assets';
import SectionHeading from './SectionHeading.astro';
---

<section class="section members" id="integrantes" aria-labelledby="members-title">
  <div class="shell">
    <SectionHeading id="members-title" {...site.sections.members} />
    <div class="member-grid">
      {site.members.map((member, index) => (
        <article class="member-card">
          {member.photo ? (
            <div class="member-card__portrait member-card__portrait--photo">
              <Image src={member.photo} alt={`${member.name}, ${member.role.toLowerCase()} de 620 Trío`} width={800} widths={[400, 800]} sizes="(min-width: 700px) 33vw, 100vw" format="webp" loading="lazy" />
            </div>
          ) : (
            <div class={`member-card__portrait member-card__portrait--${index + 1}`} aria-label={`Placeholder de foto de ${member.name}`} role="img">
              <span>{member.initials}</span>
              <small>Foto pendiente</small>
            </div>
          )}
          <div class="member-card__body">
            <p class="member-card__role">{member.role}</p>
            <h3>{member.name}</h3>
            <p>{member.detail}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
